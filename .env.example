# Optional hosted language model (server-side only)
# Gemini default endpoint/model: gemini-2.5-flash
# You may set GEMINI_API_KEY instead of EXPERT802_LLM_API_KEY.
# OPENAI_API_KEY and GROQ_API_KEY are also detected when their provider is selected.
EXPERT802_LLM_PROVIDER=gemini
EXPERT802_LLM_API_KEY=
# Optional overrides:
# EXPERT802_LLM_MODEL=gemini-2.5-flash
# EXPERT802_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Full-web search providers (first configured provider wins)
BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# BING_SEARCH_V7_SUBSCRIPTION_KEY=

# Existing security/runtime settings (configure strong secrets separately)
# EXPERT802_CSRF_SECRET=
# EXPERT802_CODE_RUN_ENABLED=false
